{
  // Statischer Blog als Cloudflare Worker mit Static Assets (kein eigener Code).
  // Test:    wrangler deploy --assets ./_probe   (nur Platzhalterseite, noindex)
  // Produktiv: python build_blog.py && wrangler deploy
  "name": "sp23-blog",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "ai-blog.sp23.online", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
