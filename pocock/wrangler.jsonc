{
  "name": "sp23-pocock",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "pocock.sp23.online", "custom_domain": true }],
  "vars": { "SITE_ORIGIN": "https://pocock.sp23.online" },
  "r2_buckets": [{ "binding": "COURSE_BUCKET", "bucket_name": "sp23-pocock-kurs" }],
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "60291029", "simple": { "limit": 5, "period": 60 } }]
}
