# Betriebssystem
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.env
.env.*
!.env.example
.env.local

# Node
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
scripts/.ingest/

# Logs
*.log
logs/

# IDE
.vscode/
.idea/

# Obsidian lokale UI-Zustände
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json

# Temporär
tmp/
temp/
.cache/

# Externe Repos (nur lokale Analyse, nicht versioniert) - Index und Changelog bleiben versioniert
external_repos/*
!external_repos/INDEX.md
!external_repos/changelog/
!external_repos/changelog/*

# Quell-Binärdateien (PDFs, Office-Dokumente, Medien, Archive)
# Bleiben lokal, z. B. in 00_Inbox/. Versioniert wird die Markdown-Auswertung
# einer Quelle, nicht das Original. Einzelfall bewusst aufnehmen: git add -f <datei>
*.pdf
*.epub
*.docx
*.doc
*.pptx
*.xlsx
*.csv.gz
*.zip
*.7z
*.tar.gz
*.mp3
*.wav
*.m4a
*.mp4
*.mov

# Agent-Werkzeuge: lokaler Laufzeit-State
# Diese Muster lagen bisher nur in .git/info/exclude und galten damit allein
# auf dem Rechner, der sie eingetragen hat. Hier wirken sie fuer jeden Clone.
# .claude/ selbst bleibt versionierbar — dort liegen geteilte Skills und
# Settings, nur der Laufzeit-State darunter gehoert nicht ins Repo.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/routines/.state/
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json
.claude/agent-memory-local/
.claude/first-run
.claude/assistant-daemon-state.json
# Review-Diffs und Fortschrittsnotizen eines lokalen Werkzeugs. Ignoriert sich
# bisher nur ueber eine .gitignore, die das Werkzeug selbst anlegt.
.superpowers/

# Secrets
secrets/
*.key
*.pem
external_knowledge/
