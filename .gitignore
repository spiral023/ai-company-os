# Betriebssystem
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.pytest_cache/
.wissen/
.venv/
venv/
.env
.env.*
!.env.example
.env.local

# Node
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
scripts/.ingest/

# Logs
*.log
logs/

# IDE
.vscode/
.idea/

# Obsidian lokale UI-Zustände
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json

# Temporär
tmp/
temp/
.cache/

# Externe Repos (nur lokale Analyse) - Index, HTML und Changelog bleiben versioniert
external_repos/*
!external_repos/INDEX.md
!external_repos/INDEX.html
!external_repos/changelog/
!external_repos/changelog/*

# Lokale Vault-Kopien fremder Inhalte ohne Lizenz (Repo ist öffentlich) - erzeugt per Script
00_Inbox/Quellen/URL/aihero-ai-coding-dictionary/

# Lokales Bucharchiv: Original und extrahierter Text bleiben außerhalb von Git
00_Inbox/Quellen/PDF/lokal/the-pragmatic-programmer-20th-anniversary-edition/
00_Inbox/Quellen/PDF/2019-09-13-pdf-the-pragmatic-programmer-20th-anniversary-edition.md

# Quell-Binärdateien (PDFs, Office-Dokumente, Medien, Archive)
# Bleiben lokal, z. B. in 00_Inbox/. Versioniert wird die Markdown-Auswertung
# einer Quelle, nicht das Original. Einzelfall bewusst aufnehmen: git add -f <datei>
*.pdf
*.epub
*.docx
*.doc
*.pptx
*.xlsx
*.csv.gz
*.zip
*.7z
*.tar.gz
*.mp3
*.wav
*.m4a
*.mp4
# Unvollständige TikTok-Downloads und Downloader-Zustand bleiben ebenfalls lokal
00_Inbox/Quellen/TikTok/medien/**/02-video.mp4.*
*.mov

# Agent-Werkzeuge: lokaler Laufzeit-State
# Diese Muster lagen bisher nur in .git/info/exclude und galten damit allein
# auf dem Rechner, der sie eingetragen hat. Hier wirken sie fuer jeden Clone.
# .claude/ selbst bleibt versionierbar — dort liegen geteilte Skills und
# Settings, nur der Laufzeit-State darunter gehoert nicht ins Repo.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/routines/.state/
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json
.claude/agent-memory-local/
.claude/first-run
.claude/assistant-daemon-state.json
# Review-Diffs und Fortschrittsnotizen eines lokalen Werkzeugs. Ignoriert sich
# bisher nur ueber eine .gitignore, die das Werkzeug selbst anlegt.
.superpowers/

# Secrets
secrets/
*.key
*.pem
external_knowledge/

# Arbeitsordner der Quellen-Pipeline
tmp/quellen-lauf/

# Lokaler Zustand von Videoprojekten; editierbare Quellen und Assets bleiben sichtbar
/videos/**/.runtime/
/videos/**/.media/
/videos/**/.thumbnails/
/videos/**/.waveform-cache/
/videos/**/.hyperframes/artifacts/
/videos/**/.hyperframes/preview*
/videos/**/.hyperframes/hf-ids-stamped.json
/videos/**/.hyperframes/history-id
/videos/**/.hyperframes/render-outputs.json
/videos/**/.hyperframes/video-state.json
/videos/**/renders/

# Blog-Build
blog/_site/
blog/_preview/

# Lokaler Quellenfeed: aus Markdown und Medien erzeugte Website
feed/_site/

# NotebookLM-Audio (groß, wird erzeugt)
reports/notebooklm/*.m4a

# Browser-Logs der Playwright-Tests
.playwright-mcp/
blog/_probe/

